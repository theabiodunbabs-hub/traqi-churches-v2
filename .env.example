# Copy this file to .env.local and fill in the values. .env.local is never uploaded.
# Without the two Supabase values, Traqi runs on demo data saved in the browser.

# Live mode (real sign-in and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Your address: http://localhost:3000 on your laptop, your live address on Vercel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only (Vercel): scheduled emails. Never put these in code or chat.
# SUPABASE_SECRET_KEY=
# CRON_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=Your Church <hello@your-domain>
# EMAIL_SENDING=on
